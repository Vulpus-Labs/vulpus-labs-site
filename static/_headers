# Cross-origin isolation for the VXN web synths (vxn-1 ticket 0045).
# SharedArrayBuffer (their audio transport) needs the page cross-origin
# isolated, which needs COOP: same-origin + COEP: require-corp on the document.
# Scoped to the synth subpaths so the rest of the site is unaffected (COOP/COEP
# site-wide can break third-party embeds / popups).
/products/vxn-2/web/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/products/vxn-1b/web/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
