# Cross-origin isolation for the web synths (vxn-1 ticket 0045).
# SharedArrayBuffer (their audio transport) needs the page cross-origin
# isolated, which needs COOP: same-origin + COEP: require-corp on the document.
# Scoped to the synth subpaths so the rest of the site is unaffected (COOP/COEP
# site-wide can break third-party embeds / popups).
# The PolyKritter web demo (silkscreen).
/products/polykritter/web/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Same cross-origin isolation for the vxn-1c web demo (silkscreen).
/products/vxn-1c/web/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# Same cross-origin isolation for the vxn-2b web demo (silkscreen).
/products/vxn-2b/web/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
